# ==============================================================================
# CRM SERVER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình cơ bản (System & Server Base)
# ------------------------------------------------------------------------------
# Môi trường chạy ứng dụng: development | production | test | developer
NODE_ENV=development

# Cổng HTTP Server lắng nghe (Port)
PORT=4000

# Danh sách URL các ứng dụng Frontend được phép truy cập CORS (phân cách bằng dấu phẩy)
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu (MongoDB)
# ------------------------------------------------------------------------------
# Chuỗi kết nối MongoDB (MongoDB Connection URI)
MONGO_URI=mongodb://127.0.0.1:27017/crm

# ------------------------------------------------------------------------------
# 3. Xác thực & Bảo mật (Authentication & Security)
# ------------------------------------------------------------------------------
# Thời hạn hết hạn của JWT Access Token (tính bằng phút) — Mặc định: 15
ACCESS_TOKEN_TTL_MINUTES=15

# Thời hạn hết hạn của Refresh Token (tính bằng ngày) — Mặc định: 30
REFRESH_TOKEN_TTL_DAYS=30

# Thời hạn hết hạn của token đặt lại mật khẩu (tính bằng phút) — Mặc định: 30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Mật khẩu mặc định khi hệ thống tự động tạo hoặc reset tài khoản
DEFAULT_USER_PASSWORD=crm@123456

# ------------------------------------------------------------------------------
# 4. Bộ nhớ đệm Cache & Redis (Caching)
# ------------------------------------------------------------------------------
# Bật/tắt bộ nhớ đệm Redis: true | false (Nếu false hệ thống sẽ lưu cache qua MongoDB)
ENABLE_REDIS=false

# URI kết nối Redis Server
REDIS_URI=redis://127.0.0.1:6379

# Tài khoản đăng nhập Redis (nếu có)
REDIS_USERNAME=dev_user

# Mật khẩu đăng nhập Redis (nếu có)
REDIS_PASSWORD=dev_password

# Thời gian lưu cache phân quyền Role/Permission của user (tính bằng giây) — Mặc định: 86400 (24h)
CACHE_ROLE_TTL_SECONDS=86400

# Thời gian lưu cache dữ liệu Metadata hệ thống (tính bằng giây) — Mặc định: 14400 (4h)
CACHE_METADATA_TTL_SECONDS=14400

# ------------------------------------------------------------------------------
# 5. Webhook chung & BotVN Webhook
# ------------------------------------------------------------------------------
# Khóa bí mật (Secret Key) xác thực Webhook chung từ đối tác
WEBHOOK_SECRET=whsec_dev_secret_key_change_in_production

# Khóa bí mật xác thực Webhook đăng nhập QR từ hệ thống BotVN
BOTVN_QR_LOGIN_WEBHOOK_SECRET=botvn_whsec_dev_secret_key

# Danh sách IP được phép gọi Webhook chung (phân cách bằng dấu phẩy, để trống = cho phép tất cả)
WEBHOOK_ALLOWED_IPS=

# ------------------------------------------------------------------------------
# 6. External API & Mã hóa Video (External API & Media Security)
# ------------------------------------------------------------------------------
# API Key chung dùng cho các dịch vụ đối tác bên ngoài gọi vào CRM Server
EXTERNAL_API_KEY=botvn_key_123

# Khóa mã hóa 32-byte (64 ký tự hex) dùng mã hóa AES-256-GCM cho video ID khoá học
# Tạo ngẫu nhiên bằng lệnh Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIDEO_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Nhà cung cấp phát video (youtube | vimeo | custom) — Mặc định: youtube
VIDEO_PROVIDER=youtube

# Domain gốc dùng cho việc nhúng video player / iframe
BOTVN_DOMAIN=https://botvn.com

# ------------------------------------------------------------------------------
# 7. BotVN Auth & Khách Hàng (Customer Authentication)
# ------------------------------------------------------------------------------
# Thời gian hết hạn của Customer Access Token (tính bằng phút) — Mặc định: 1440 (1 ngày)
BOTVN_ACCESS_TOKEN_TTL_MINUTES=1440

# Thời gian hết hạn của Customer Refresh Token (tính bằng ngày) — Mặc định: 15
BOTVN_REFRESH_TOKEN_TTL_DAYS=15

# Thời gian tồn tại của mã QR Đăng nhập (tính bằng giây) — Mặc định: 180 (3 phút)
BOTVN_QR_TOKEN_TTL_SECONDS=180

# Thời gian hết hạn của mã OTP xác thực đăng ký (tính bằng giây) — Mặc định: 300 (5 phút)
BOTVN_OTP_TTL_SECONDS=300

# URL API bên thứ 3 gửi OTP (rỗng = chỉ log OTP ra console server cho dev test)
BOTVN_OTP_API_URL=

# API Key xác thực bên thứ 3 gửi OTP (truyền qua header Authorization: Bearer <key>)
BOTVN_OTP_API_KEY=

# ------------------------------------------------------------------------------
# 8. Google OAuth cho BotVN (Google Identity Services)
# ------------------------------------------------------------------------------
# Google OAuth Client ID (từ Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
BOTVN_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 9. Tích hợp Dịch vụ ZCode (ZCode Integration)
# ------------------------------------------------------------------------------
# Danh sách các mã gói / SKU ZCode hợp lệ được hệ thống chấp nhận (phân cách bằng dấu phẩy)
ZCODE_SKUS=ZB5000,ZB10000,ZC10GB,ZC100GB,ZC500GB,ZC1T

# Danh sách IP được phép gọi API ZCode (phân cách bằng dấu phẩy, 0.0.0.0 = cho phép tất cả)
ZCODE_ALLOWED_IPS=0.0.0.0

# API Key cho dịch vụ ZCode (truyền qua header X-API-Key)
ZCODE_API_KEY=zcode_secret_key_change_in_production

# Khóa mã hóa dữ liệu nhạy cảm ZCode
ZCODE_ENCRYPTION_KEY=zcode_encryption_key_change_in_production

# ------------------------------------------------------------------------------
# 9. Tích hợp Webhook Ngân Hàng ACB (ACB Bank Webhook - SHA256 Checksum)
# ------------------------------------------------------------------------------
# API Key xác thực Webhook ACB (yêu cầu truyền trong header X-API-Key)
ACB_WEBHOOK_API_KEY=acb_webhook_key_change_in_production

# Secret Key — VIK tạo & cung cấp cho ACB (ACB gọi là "secret_key" trong cấu hình checksum)
ACB_WEBHOOK_SECRET_KEY=acb_secret_key_change_in_production

# Bank Key — ACB tạo & cung cấp cho VIK (ACB gọi là "server_key" trong cấu hình checksum)
ACB_WEBHOOK_BANK_KEY=acb_bank_key_change_in_production

# Tên header chứa giá trị checksum do ACB gửi (mặc định: signature)
ACB_WEBHOOK_CHECKSUM_HEADER=signature

# Thuật toán băm checksum: SHA1 | SHA256 | SHA512 | MD5 (mặc định: SHA256)
ACB_WEBHOOK_CHECKSUM_ALGORITHM=SHA256

# Danh sách IP tĩnh của ACB được phép gọi Webhook (phân cách bằng dấu phẩy, hỗ trợ CIDR, 0.0.0.0 = cho phép tất cả)
ACB_WEBHOOK_ALLOWED_IPS=0.0.0.0

# ------------------------------------------------------------------------------
# 10. Tích hợp Smax AI Credit (Smax AI Integration)
# ------------------------------------------------------------------------------
# URL API kiểm tra & trừ điểm tín dụng Smax AI
SMAX_CREDIT_VALIDATION_URL=https://dev.smax.ai/api/backdoors/botvn/billing

# JWT Token xác thực truy cập API Smax AI Credit
SMAX_CREDIT_VALIDATION_TOKEN=

# ------------------------------------------------------------------------------
# 11. Cờ tính năng (Feature Flags)
# ------------------------------------------------------------------------------
# Bật/Tắt tính năng nhân bản cập nhật (true | false)
ENABLE_CLONE_UPDATE=true

# Bật/Tắt tự động thử lại request HTTP khi gặp lỗi kết nối (true | false)
ENABLE_HTTP_RETRY=false

# ------------------------------------------------------------------------------
# 12. Cấu hình Khởi tạo Hệ thống (Seed / Init Prod Scripts)
# ------------------------------------------------------------------------------
# Thông tin tài khoản OWNER ban đầu (sử dụng khi chạy script src/scripts/initProd.js)
OWNER_EMAIL=owner@company.vn
OWNER_PASSWORD=Owner@Password123
OWNER_NAME="Chủ hệ thống CRM"

# Thông tin tài khoản ADMIN ban đầu (sử dụng khi chạy script src/scripts/initProd.js)
ADMIN_EMAIL=admin@company.vn
ADMIN_PASSWORD=Admin@Password123
ADMIN_NAME="Quản trị CRM"

# ------------------------------------------------------------------------------
# 13. Tích hợp Hoá đơn Điện tử BKAV (eInvoice Integration)
# ------------------------------------------------------------------------------
# Endpoint WebService BKAV eHoaDon
# Dev/Demo: https://wsdemo.ehoadon.vn/WSPublicEHoaDon.asmx
# Production: https://ws.ehoadon.vn/WSPublicEHoaDon.asmx
BKAV_INVOICE_ENDPOINT=https://wsdemo.ehoadon.vn/WSPublicEHoaDon.asmx

# PartnerGUID — ID định danh điểm gửi dữ liệu (do BKAV cấp)
BKAV_INVOICE_PARTNER_GUID=

# PartnerToken — Chuỗi mã hoá AES-256 (Key:IV format, do BKAV cấp)
# Ví dụ: 54dSxtErH+vsKKfL4PKaoerNYE6dwzmpzkLAxity8F4=:+bRSEW7FUEnzLy9xjuP5wA==
BKAV_INVOICE_PARTNER_TOKEN=

# CmdType — Mã lệnh tạo hoá đơn: 100, 101, 110, 111, 112 (xem FAQ_WebServices_Bkav)
# 111 = PMKT quản lý Mẫu số + Ký hiệu + Số HĐ, trạng thái "Hoá đơn chờ"
BKAV_INVOICE_CMD_TYPE=111

# Ký hiệu Hoá đơn — do BKAV cấp (VD: MAA, MVK)
BKAV_INVOICE_SERIAL=

# ------------------------------------------------------------------------------
# 14. Tích hợp Hệ thống (System Integrations)
# ------------------------------------------------------------------------------
# Cấu hình danh sách các event hệ thống định nghĩa sẵn dạng JSON String
# SYSTEM_INTEGRATION_EVENTS='{"smaxai":[{"value":"user_moi","label":"Smax - User mới"},{"value":"biz_moi","label":"Smax - Biz mới"},{"value":"can_nang_cap","label":"Smax - Cần nâng cấp"},{"value":"sap_het_han","label":"Smax - Sắp hết hạn"},{"value":"user_login","label":"Smax - User đăng nhập"},{"value":"order_create","label":"Smax - Đơn hàng mới"},{"value":"order_active","label":"Smax - Kích hoạt đơn hàng"}],"botvn":[{"value":"botvn_yeu_thich","label":"BotVN - Yêu thích khoá học"},{"value":"botvn_dang_ky","label":"BotVN - Đăng ký BotVN"},{"value":"botvn_mua_khoa_hoc","label":"BotVN - Mua khoá học"}],"zcode":[{"value":"zcode_dang_ky","label":"ZCode - Đăng ký tài khoản"}]}'
SYSTEM_INTEGRATION_EVENTS=
