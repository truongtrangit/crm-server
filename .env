# ==============================================================================
# CRM SERVER — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. System & Server Base
NODE_ENV=developer
PORT=4000
CLIENT_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3001

# 2. MongoDB
MONGO_URI=mongodb+srv://crm-server-admin:vhQLRhm6GjazOsKL@crm-server.bqzf1de.mongodb.net/?appName=crm-server
# MONGO_URI=mongodb://localhost:27019/?directConnection=true

# 3. Authentication & Security
ACCESS_TOKEN_TTL_MINUTES=1200
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
DEFAULT_USER_PASSWORD=crm@123456

# 4. Caching & Redis
ENABLE_REDIS=false
REDIS_URI=redis://localhost:6379
REDIS_USERNAME=admin
REDIS_PASSWORD=cw82oKff2mU1RxDpIssDd7FKK7v
CACHE_ROLE_TTL_SECONDS=300
CACHE_METADATA_TTL_SECONDS=1800

# 5. Webhook chung & BotVN QR Webhook
WEBHOOK_SECRET=whsec_dev_secret_key_change_in_production
BOTVN_QR_LOGIN_WEBHOOK_SECRET=botvn_whsec_dev_secret_key_change_in_production
WEBHOOK_ALLOWED_IPS=

# 6. External API, Zalo Mini App & Video Security
INTEGRATION_WEBHOOK_API_KEY=botvn_key_123
BOTVN_ZALO_MINI_APP_API_KEY=botvn_zalo_mini_app_secret_key
VIDEO_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
VIDEO_PROVIDER=youtube
BOTVN_DOMAIN=https://botvn.com

# 7. BotVN Auth & OTP
BOTVN_ACCESS_TOKEN_TTL_MINUTES=1440
BOTVN_REFRESH_TOKEN_TTL_DAYS=15
BOTVN_QR_TOKEN_TTL_SECONDS=180
BOTVN_OTP_TTL_SECONDS=60
BOTVN_OTP_API_URL=
BOTVN_OTP_API_KEY=

# 8. Google OAuth
BOTVN_GOOGLE_CLIENT_ID=

# 9. ZCode Integration
ZCODE_SKUS=ZB5000,ZB10000,ZC10GB,ZC100GB,ZC500GB,ZC1T
ZCODE_ALLOWED_IPS=0.0.0.0
ZCODE_API_KEY=zcode_secret_key_change_in_production
