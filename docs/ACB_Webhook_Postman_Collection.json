									"    pm.expect(json.responseCode).to.eql('00000000');",
									"    pm.expect(json.responseBody.index).to.eql(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-API-Key", "value": "{{acbApiKey}}" },
							{ "key": "signature", "value": "auto-generated-by-script" }
						],
						"body": { "mode": "raw", "raw": "{}" },
						"url": {
							"raw": "{{baseUrl}}/transaction",
							"host": ["{{baseUrl}}"],
							"path": ["transaction"]
						},
						"description": "✅ Gửi giao dịch Debit (báo nợ — tiền RA khỏi tài khoản).\n\n**Expected:** HTTP 200, responseCode \"00000000\""
					}
				},
