				{
					"name": "1.4 Duplicate clientRequestId — Idempotent (200)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// ─── Gửi lại cùng clientRequestId từ request 1.1 ───",
									"// Phải chạy request 1.1 trước để lưu lastClientRequestId và lastRawBody",
									"// using built-in CryptoJS and {{$guid}}",
									"",
									"const lastBody = pm.variables.get('lastRawBody');",
									"if (!lastBody) {",
									"    console.error('❌ Chạy request 1.1 trước để lưu lastRawBody!');",
									"    throw new Error('lastRawBody not found — run request 1.1 first');",
									"}",
									"",
									"pm.request.body.update({ mode: 'raw', raw: lastBody });",
									"",
									"const secretKey = pm.variables.get('acbSecretKey');",
									"const bankKey = pm.variables.get('acbBankKey');",
									"const checksum = CryptoJS.SHA256(lastBody + secretKey + bankKey).toString(CryptoJS.enc.Hex);",
									"pm.request.headers.upsert({ key: 'signature', value: checksum });",
									"",
									"console.log('🔄 Replaying clientRequestId:', pm.variables.get('lastClientRequestId'));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK (idempotent)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is still success (idempotent, not an error)', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.responseCode).to.eql('00000000');",
									"    pm.expect(json.message).to.eql('Success');",
									"});"
								],
								"type": "text/javascript"
							}
