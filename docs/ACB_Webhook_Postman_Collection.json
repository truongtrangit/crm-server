									"// ─── Gửi lại cùng 1 txId cố định để test Idempotency ───",
									"const crypto = require('crypto');",
									"",
									"const bodyObj = {",
									"  txId: 'ACB_FIXED_TEST_DUPLICATE_001',",
									"  amount: 1000000,",
									"  sender: 'TRAN VAN B',",
									"  content: 'Chuyen khoan trung lap',",
									"  transactionDate: new Date().toISOString()",
									"};",
									"",
									"const bodyRaw = JSON.stringify(bodyObj);",
									"pm.request.body.update({ mode: 'raw', raw: bodyRaw });",
									"",
									"// ─── Ed25519 Signing ───",
									"const privateKeyPem = pm.environment.get('acbEd25519PrivateKey') || pm.collectionVariables.get('acbEd25519PrivateKey');",
									"const timestamp = Math.floor(Date.now() / 1000).toString();",
									"",
									"const signedPayload = Buffer.concat([Buffer.from(timestamp + '.'), Buffer.from(bodyRaw)]);",
									"const signatureHex = crypto.sign(null, signedPayload, privateKeyPem).toString('hex');",
									"",
									"pm.request.headers.upsert({ key: 'X-Webhook-Timestamp', value: timestamp });",
									"pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: 'ed25519=' + signatureHex });"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK (idempotent)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Handled idempotently without 500 error', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.success).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-API-Key", "value": "{{acbApiKey}}" },
							{ "key": "X-Webhook-Signature", "value": "auto-generated-by-script" },
							{ "key": "X-Webhook-Timestamp", "value": "auto-generated-by-script" }
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{baseUrl}}/transaction",
							"host": ["{{baseUrl}}"],
							"path": ["transaction"]
						},
						"description": "✅ Test tính Idempotency khi gửi trùng `txId`.\n\n**Cách test:**\n1. Nhấn Send lần 1 → 200 OK (tạo mới)\n2. Nhấn Send lần 2 → 200 OK (duplicate, không crash 500)\n\n**Expected:** HTTP 200, `success: true`"
					}
				}
			]
		},
