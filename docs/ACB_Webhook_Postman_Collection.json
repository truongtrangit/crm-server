									"const expiredTimestamp = (Math.floor(Date.now() / 1000) - 600).toString();",
									"",
									"const signedPayload = Buffer.concat([Buffer.from(expiredTimestamp + '.'), Buffer.from(bodyRaw)]);",
									"const signatureHex = crypto.sign(null, signedPayload, privateKeyPem).toString('hex');",
									"",
									"pm.request.headers.upsert({ key: 'X-Webhook-Timestamp', value: expiredTimestamp });",
									"pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: 'ed25519=' + signatureHex });",
									"",
									"console.log('⏰ Expired timestamp:', expiredTimestamp, '(10 phút trước)');"
								],
								"type": "text/javascript"
							}
